classDiagram
    direction TB

    class VerificationItem:::epic4 {
        +kind: string
        +expectedOutcome: string
        +instructions: string
        +acceptanceCriteria: string
        +status: string
        +responsible: string
        +supplier: string
        +customer: string
    }
    class Requirement:::asIs
    class File:::asIs
    class TestCase:::asIs
    class TestCaseExecution:::asIs
    class TestRun:::asIs
    class PhaseContext:::epic1
    class Register:::asIs

    VerificationItem "1" --> "1" PhaseContext : assessed in
    VerificationItem "1" --> "*" Requirement : assessment subject
    VerificationItem "1" --> "*" File : assessment subject
    VerificationItem "1" --> "*" File : supporting input
    VerificationItem "1" --> "*" TestCaseExecution : executed as
    TestCaseExecution "*" --> "*" File : evidence output
    TestRun "1" --> "*" VerificationItem : includes
    TestCase ..> VerificationItem : as-is stand-in for test kind
    VerificationItem "*" --> "0..1" VerificationItem : re-verifies
    Register "*" --> "0..1" VerificationItem : finding on

    classDef asIs fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef epic1 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#bf360c
    classDef epic4 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
